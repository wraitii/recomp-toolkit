find_program(RECOMP_GRAPHICS_CARGO cargo REQUIRED)
if(CMAKE_CROSSCOMPILING OR (CMAKE_OSX_ARCHITECTURES AND
    NOT CMAKE_OSX_ARCHITECTURES STREQUAL CMAKE_HOST_SYSTEM_PROCESSOR))
  message(FATAL_ERROR "Rust graphics integration requires a native single-architecture build")
endif()
set(RECOMP_GRAPHICS_TARGET_ARGS)
set(RECOMP_GRAPHICS_TARGET_SUFFIX "")
if(RECOMP_RENDERER_CARGO_TARGET)
  if(NOT RECOMP_RENDERER_CARGO_TARGET MATCHES "^[A-Za-z0-9_+.-]+$")
    message(FATAL_ERROR "Invalid renderer Cargo target triple: ${RECOMP_RENDERER_CARGO_TARGET}")
  endif()
  if(DEFINED ENV{RUSTC} AND NOT "$ENV{RUSTC}" STREQUAL "")
    set(RECOMP_RUSTC "$ENV{RUSTC}")
  else()
    find_program(RECOMP_RUSTC rustc REQUIRED)
  endif()
  execute_process(COMMAND "${RECOMP_RUSTC}" -vV RESULT_VARIABLE RECOMP_RUSTC_STATUS
    OUTPUT_VARIABLE RECOMP_RUSTC_VERSION ERROR_VARIABLE RECOMP_RUSTC_ERROR)
  if(NOT RECOMP_RUSTC_STATUS EQUAL 0 OR NOT RECOMP_RUSTC_VERSION MATCHES "host: ([^\r\n]+)")
    message(FATAL_ERROR "Could not determine Rust host target: ${RECOMP_RUSTC_ERROR}")
  endif()
  if(NOT RECOMP_RENDERER_CARGO_TARGET STREQUAL CMAKE_MATCH_1)
    message(FATAL_ERROR "Renderer Cargo target ${RECOMP_RENDERER_CARGO_TARGET} does not match Rust host ${CMAKE_MATCH_1}")
  endif()
  list(APPEND RECOMP_GRAPHICS_TARGET_ARGS --target "${RECOMP_RENDERER_CARGO_TARGET}")
  set(RECOMP_GRAPHICS_TARGET_SUFFIX "/${RECOMP_RENDERER_CARGO_TARGET}")
endif()
set(RECOMP_GRAPHICS_DEPLOYMENT_ARGS)
if(APPLE)
  set(RECOMP_GRAPHICS_DEPLOYMENT_TARGET "${CMAKE_OSX_DEPLOYMENT_TARGET}")
  if(NOT RECOMP_GRAPHICS_DEPLOYMENT_TARGET)
    if(CMAKE_OTOOL)
      set(RECOMP_GRAPHICS_OTOOL "${CMAKE_OTOOL}")
    else()
      find_program(RECOMP_GRAPHICS_OTOOL NAMES otool)
    endif()
    set(RECOMP_GRAPHICS_COMPILER_ABI "${CMAKE_PLATFORM_INFO_DIR}/CMakeDetermineCompilerABI_CXX.bin")
    if(RECOMP_GRAPHICS_OTOOL AND EXISTS "${RECOMP_GRAPHICS_COMPILER_ABI}")
      execute_process(
        COMMAND "${RECOMP_GRAPHICS_OTOOL}" -l "${RECOMP_GRAPHICS_COMPILER_ABI}"
        RESULT_VARIABLE RECOMP_GRAPHICS_OTOOL_STATUS
        OUTPUT_VARIABLE RECOMP_GRAPHICS_LOAD_COMMANDS
        ERROR_QUIET)
      if(RECOMP_GRAPHICS_OTOOL_STATUS EQUAL 0 AND
          RECOMP_GRAPHICS_LOAD_COMMANDS MATCHES "minos[ \t]+([0-9]+(\\.[0-9]+)*)")
        set(RECOMP_GRAPHICS_DEPLOYMENT_TARGET "${CMAKE_MATCH_1}")
      elseif(RECOMP_GRAPHICS_OTOOL_STATUS EQUAL 0 AND
          RECOMP_GRAPHICS_LOAD_COMMANDS MATCHES "cmd LC_VERSION_MIN_MACOSX[\r\n]+[^\r\n]+[\r\n]+[ \t]*version[ \t]+([0-9]+(\\.[0-9]+)*)")
        set(RECOMP_GRAPHICS_DEPLOYMENT_TARGET "${CMAKE_MATCH_1}")
      endif()
    endif()
    if(NOT RECOMP_GRAPHICS_DEPLOYMENT_TARGET)
      message(FATAL_ERROR "Could not determine the native macOS deployment target from CMAKE_OSX_DEPLOYMENT_TARGET or the CMake C++ ABI probe")
    endif()
  endif()
  list(APPEND RECOMP_GRAPHICS_DEPLOYMENT_ARGS --deployment-target "${RECOMP_GRAPHICS_DEPLOYMENT_TARGET}")
endif()
